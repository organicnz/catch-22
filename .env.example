# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url
# Publishable key (sb_publishable_...) — safe for client-side use with RLS enabled
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# Secret key (sb_secret_...) — server-side only, never expose client-side
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Stripe Configuration (Optional for local dev)
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# App
# Canonical site URL used by sitemap/robots and as the checkout fallback origin
NEXT_PUBLIC_SITE_URL=https://catch-22.co.nz

# Bank transfer (direct deposit) checkout
# Shown to customers after they place a bank-transfer order. Required in
# production — without all three, bank-transfer checkout refuses to take
# orders rather than showing a placeholder account. Missing values fall back
# to a clearly-labelled test account in development only.
BANK_TRANSFER_BANK_NAME=ANZ
BANK_TRANSFER_ACCOUNT_NAME=Your Business Name
BANK_TRANSFER_ACCOUNT_NUMBER=06-XXXX-XXXXXXX-XX

# Email Notifications (Resend — https://resend.com)
RESEND_API_KEY=re_your-resend-api-key
# Email address to receive new order notifications
ADMIN_ORDER_EMAIL=orders@catch-22.co.nz
# From address — must be a domain verified in Resend (or use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=orders@catch-22.co.nz

# Contact notifications — override for tests; defaults to
# ${NEXT_PUBLIC_SUPABASE_URL}/functions/v1/notify-contact
# CONTACT_FUNCTION_URL=http://localhost:3101/notify-contact
# Contact form submissions per IP per 10 minutes (default 3, env optional)
# CONTACT_RATE_LIMIT_MAX=3

# Supabase project ref — used by CLI tooling (types:generate, db push)
# and CI probes. Derive from NEXT_PUBLIC_SUPABASE_URL: the subdomain before
# .supabase.co (e.g. wcoaqlglwxwceqktpckt). Env optional — fallback baked in.
# SUPABASE_PROJECT_REF=wcoaqlglwxwceqktpckt

# CI-only — Management API token for db push / secrets (never in the app).
# Acquire via Supabase Dashboard → Account → Access Tokens (sbp_...).
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
