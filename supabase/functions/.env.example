# Supabase Edge Function secrets — copy to .env and fill in values
# Deploy to production with: supabase secrets set --env-file supabase/functions/.env
# List current secrets:      supabase secrets list

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=https://catch-22-next.vercel.app

# Email notifications (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=orders@catch-22.co.nz
ADMIN_ORDER_EMAIL=orders@catch-22.co.nz

# Bank transfer (direct deposit) checkout
# Stored in the Vault alongside other config so all runtime values live in one place.
# The Next.js server action reads these via process.env — mirror them in
# Vercel Dashboard → Settings → Environment Variables → Production as well.
BANK_TRANSFER_BANK_NAME=ANZ
BANK_TRANSFER_ACCOUNT_NAME=Your Business Name
BANK_TRANSFER_ACCOUNT_NUMBER=06-XXXX-XXXXXXX-XX
